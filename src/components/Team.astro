---
import { getOrdered } from '../lib/collections';
import { useI18n } from '../i18n';

const { locale } = useI18n(Astro.currentLocale);
const members = await getOrdered('team');
const photo = (file: string) => `${import.meta.env.BASE_URL}${file}`;
---

<ul class="grid">
  {
    members.map(({ data }, i) => (
      <li>
        <div class="frame paper corners">
          {data.photo ? (
            <img src={photo(data.photo)} alt={`${data.name} ${data.surname}`} loading="lazy" />
          ) : (
            <span class="initials" aria-hidden="true">
              {data.name[0]}
              {data.surname[0]}
            </span>
          )}
          <span class="mono faint idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        </div>
        <h3>
          {[data.titleBefore, data.name].filter(Boolean).join(' ')}{' '}
          <span>{[data.surname, data.titleAfter].filter(Boolean).join(', ')}</span>
        </h3>
        <p class="mono role">{data.role[locale]}</p>
      </li>
    ))
  }
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 40px) clamp(16px, 2vw, 24px);
  }

  .frame {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    --cell: 16px;
    --corner: 10px;
    --corner-inset: 12px;
  }

  .frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.3s ease;
  }

  li:hover .frame img {
    filter: none;
  }

  .initials {
    font-family: var(--f-serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-style: italic;
    color: var(--c-accent);
    letter-spacing: 0.02em;
  }

  .idx {
    position: absolute;
    top: 22px;
    left: 24px;
    font-size: 0.625rem;
    z-index: 1;
  }

  h3 {
    margin-top: 14px;
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  h3 span {
    display: block;
    font-weight: 500;
    color: var(--c-ink-soft);
  }

  .role {
    margin-top: 6px;
    color: var(--c-accent);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
