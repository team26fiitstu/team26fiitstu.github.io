---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="ruler" aria-hidden="true">
  <span class="ticks"></span>
  <span class="mono faint">{label}</span>
  <span class="ticks"></span>
</div>

<style>
  .ruler {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ticks {
    flex: 1;
    height: 9px;
    background:
      linear-gradient(var(--c-line), var(--c-line)) bottom / 100% 1px no-repeat,
      repeating-linear-gradient(90deg, var(--c-ink-faint) 0 1px, transparent 1px 48px) bottom / 100% 9px no-repeat,
      repeating-linear-gradient(90deg, var(--c-line) 0 1px, transparent 1px 8px) bottom / 100% 5px no-repeat;
  }

  .mono {
    white-space: nowrap;
  }
</style>
