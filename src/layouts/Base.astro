---
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, useI18n } from '../i18n';

const { locale, t } = useI18n(Astro.currentLocale);
const favicon = `${import.meta.env.BASE_URL}favicon.png`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <meta name="theme-color" content="#fbfbfa" />
    <link rel="icon" type="image/png" href={favicon} />
    <link rel="canonical" href={getAbsoluteLocaleUrl(locale)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />)}
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <Header />
    <main id="top">
      <slot />
    </main>
    <Footer />
  </body>
</html>
